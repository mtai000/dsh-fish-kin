{
  "name": "dsh-fish-kin",
  "version": "0.30.6",
  "description": "大肥鱼子代传承 + 自己的鱼：事件流人格、记忆退化、生育传承，并把 B 站（挑选/日报/私信分享/本地转写）内置成她自己的工具——人设由她本人负责。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "docs",
    "tools"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.2": "unknown",
        "0.2.1-rc.3": "unknown"
      },
      "profiles": [
        "desktop",
        "web",
        "headless"
      ]
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-fish",
    "lineage",
    "bilibili",
    "bili",
    "刷B站",
    "bili-scroll"
  ],
  "author": "ssamurias",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtai000/dsh-fish-kin.git"
  },
  "homepage": "https://github.com/mtai000/dsh-fish-kin#readme",
  "bugs": {
    "url": "https://github.com/mtai000/dsh-fish-kin/issues"
  }
}
